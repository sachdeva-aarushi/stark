# ==============================================================================
# Multi-Agent AI Workflow Automation Platform — Environment Configuration
# ==============================================================================

# Application Configuration
APP_NAME="Multi-Agent AI Workflow Platform"
APP_ENV="production" # development | test | production
API_HOST="0.0.0.0"
API_PORT=8000
LOG_LEVEL="INFO"

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# LLM Configuration (Groq / OpenAI)
# LLM_PROVIDER: "openai" | "groq" | "azure" | "ollama" | "mock"
LLM_PROVIDER="openai"
LLM_MODEL="openai/gpt-oss-120b"
LLM_API_KEY="gsk_your_groq_api_key_here"
LLM_BASE_URL="https://api.groq.com/openai/v1"

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql+asyncpg://postgres:password@db.your-supabase-ref.supabase.co:5432/postgres"

# Document Ingestion & Vector Settings 
DOCUMENT_STORAGE_PATH="./data/documents"
FAISS_INDEX_PATH="./data/faiss"
# EMBEDDING_PROVIDER: "google" | "local" | "mock" | "openai"
EMBEDDING_PROVIDER="google"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSION=768
GEMINI_API_KEY="your-gemini-api-key"
CHUNK_SIZE=1000
MAX_DOCUMENT_SIZE_MB=25

# Validation & Guardrails Settings
VALIDATION_ENABLED=true
MAX_VALIDATION_ATTEMPTS=2
VALIDATION_SCORE_THRESHOLD=0.8

# Human-in-the-Loop & Approval Settings
APPROVAL_ENABLED=true
MAX_APPROVAL_REVISIONS=3

# Production Hardening & Operational Timeouts
ENABLE_DOCS=true
LLM_TIMEOUT=60.0
WORKFLOW_TIMEOUT_SECONDS=120.0
DB_POOL_TIMEOUT=30.0
CHECKPOINTER_POOL_TIMEOUT=10.0

# Supabase Storage & Project Settings
PUBLIC_URL="https://your-supabase-ref.supabase.co"
PUBLISHABLE_KEY="sb_publishable_your_key_here"
SECRET_KEY="sb_secret_your_key_here"
